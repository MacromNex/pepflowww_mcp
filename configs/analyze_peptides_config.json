{
  "_description": "Configuration for cyclic peptide analysis script",
  "_source": "Extracted from examples/use_case_5_peptide_analysis.py",

  "analysis": {
    "include_composition": true,
    "include_properties": true,
    "include_druggability": true,
    "validate_sequences": true
  },

  "visualization": {
    "include_visualizations": true,
    "plot_style": "default",
    "plot_dpi": 300,
    "figure_size": [10, 6]
  },

  "druggability_criteria": {
    "max_molecular_weight": 2000,
    "max_absolute_charge": 3,
    "hydrophobicity_range": [-2.0, 2.0],
    "max_cyclizable_length": 12,
    "min_positive_charge_cpt": 2,
    "min_aromaticity_cpt": 0.2
  },

  "output": {
    "format": "csv",
    "include_metadata": true,
    "create_summary": true,
    "save_visualizations": true
  },

  "amino_acid_properties": {
    "use_kyte_doolittle": true,
    "include_flexibility": true,
    "include_aromaticity": true,
    "molecular_weight_units": "Da"
  }
}